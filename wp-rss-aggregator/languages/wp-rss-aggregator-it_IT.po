#: core/modules/aiHubPromotionalNotice.php:73
#: core/js/dist/admin.js:43
msgid "Automatically rewrite imported articles into something new and original. No more duplicate content."
msgstr "Riscrivi automaticamente gli articoli importati in qualcosa di nuovo e originale. Niente più contenuti duplicati."

#: core/modules/aiHubPromotionalNotice.php:55
#: core/js/dist/admin.js:43
msgid "Aggregator can rewrite the articles from your feeds into original pieces, ready to publish and unique to your site, with <strong>no more duplicate content.</strong>"
msgstr "Aggregator può riscrivere gli articoli dei tuoi feed in contenuti originali, pronti per la pubblicazione e unici per il tuo sito, <strong>senza più contenuti duplicati.</strong>"

