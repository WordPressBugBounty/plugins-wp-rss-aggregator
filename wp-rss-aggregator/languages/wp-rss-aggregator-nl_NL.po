#: core/modules/aiHubPromotionalNotice.php:75
#: core/js/dist/admin.js:43
msgid "Pro and Elite plans can now automatically rewrite imported articles into unique, ready-to-publish pieces, with <strong>no extra setup or charges.</strong>"
msgstr "Pro en Elite abonnementen kunnen geïmporteerde artikelen nu automatisch herschrijven tot unieke, publicatieklare stukken, <strong>zonder extra setup of kosten.</strong>"

#: core/modules/aiHubPromotionalNotice.php:35
#: core/js/dist/admin.js:43
msgid "Your imported articles can now rewrite themselves into something new."
msgstr "Je geïmporteerde artikelen kunnen zichzelf nu herschrijven tot iets nieuws."

#: core/modules/aiHubPromotionalNotice.php:37
#: core/js/dist/admin.js:43
msgid "Aggregator’s AI rewrites your feeds’ articles into original pieces. <strong>Eliminate duplicate content</strong> and automatically publish unique pieces on a regular basis."
msgstr "De AI van Aggregator herschrijft de artikelen uit je feeds tot originele stukken. <strong>Voorkom dubbele content</strong> en publiceer automatisch en regelmatig unieke stukken."

